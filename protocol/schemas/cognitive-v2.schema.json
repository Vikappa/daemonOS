{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Awakening response v2",
  "description": "Runtime additionally enforces 2048 UTF-8 bytes, byte-based strings, known capabilities and unique personality traits. Speech may be null; raw UTF-8 is supported, Unicode escape sequences are rejected by the bounded decoder.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "speech",
    "emotion",
    "intensity",
    "facial_expression",
    "animation",
    "voice",
    "actions",
    "memory_candidates",
    "personality_adjustments",
    "intentions"
  ],
  "properties": {
    "v": {
      "const": 2
    },
    "speech": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 511
        }
      ]
    },
    "emotion": {
      "enum": [
        "calm",
        "happy",
        "sad",
        "curious"
      ]
    },
    "intensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "facial_expression": {
      "enum": [
        "neutral",
        "smile",
        "sleepy",
        "concerned"
      ]
    },
    "animation": {
      "enum": [
        "idle",
        "sleep",
        "happy"
      ]
    },
    "voice": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rate",
            "pitch",
            "volume"
          ],
          "properties": {
            "rate": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2
            },
            "pitch": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "actions": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "speak",
          "animate",
          "remember",
          "propose_personality",
          "propose_intention"
        ]
      }
    },
    "memory_candidates": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content",
          "importance",
          "valence"
        ],
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "importance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "valence": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        }
      }
    },
    "personality_adjustments": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trait",
          "delta"
        ],
        "properties": {
          "trait": {
            "enum": [
              "curiosity",
              "sociability",
              "resilience"
            ]
          },
          "delta": {
            "type": "number",
            "minimum": -0.05,
            "maximum": 0.05
          }
        }
      }
    },
    "intentions": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "after_seconds"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 95
          },
          "after_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 604800
          }
        }
      }
    }
  }
}
