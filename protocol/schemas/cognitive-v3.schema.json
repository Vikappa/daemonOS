  "oneOf": [
    {
      "title": "D\u00e6monOS cognitive response v3: scheduled agent tasks and service bindings",
      "description": "Runtime enforces a 4096-byte UTF-8 response, byte-based string bounds, at most two calls, local capability policy and scheduling horizon. Literal UTF-8 is accepted; Unicode escapes are not decoded.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speech",
        "emotion",
        "intensity",
        "animation",
        "actions",
        "tool_calls"
      ],
      "properties": {
        "speech": {
          "type": "string",
          "maxLength": 511
        },
        "emotion": {
          "enum": [
            "calm",
            "happy",
            "sad",
            "curious"
          ]
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "animation": {
          "enum": [
            "idle",
            "sleep",
            "happy"
