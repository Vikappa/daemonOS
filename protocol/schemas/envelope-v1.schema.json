{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daemon Link v1 envelope (proposal)",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "session", "id", "type", "seq", "final", "payload"],
  "properties": {
    "v": {"const": 1},
    "session": {"type": "string", "minLength": 1, "maxLength": 64},
    "id": {"type": "string", "minLength": 1, "maxLength": 64},
    "reply_to": {"type": "string", "minLength": 1, "maxLength": 64},
    "type": {"enum": ["hello", "hello_ack", "error", "event", "command", "inference_request", "inference_chunk", "audio_start", "audio_chunk", "audio_end", "cancel", "backup_request", "backup_chunk", "ack"]},
    "seq": {"type": "integer", "minimum": 0, "maximum": 65535},
    "final": {"type": "boolean"},
    "payload": {"type": "object"}
  }
}
