{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {"name": "desktop", "generator": "Ninja", "binaryDir": "${sourceDir}/build/desktop",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}},
    {"name": "sanitize", "inherits": "desktop", "binaryDir": "${sourceDir}/build/sanitize",
     "cacheVariables": {"DAEMON_SANITIZE": "ON"}},
    {"name": "core", "inherits": "desktop", "binaryDir": "${sourceDir}/build/core",
     "cacheVariables": {"DAEMON_BUILD_SIMULATOR": "OFF"}},
    {"name": "release", "inherits": "desktop", "binaryDir": "${sourceDir}/build/release",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}}
  ],
  "buildPresets": [
    {"name": "desktop", "configurePreset": "desktop", "jobs": 4},
    {"name": "sanitize", "configurePreset": "sanitize", "jobs": 4},
    {"name": "core", "configurePreset": "core", "jobs": 4},
    {"name": "release", "configurePreset": "release", "jobs": 4}
  ],
  "testPresets": [
    {"name": "desktop", "configurePreset": "desktop", "output": {"outputOnFailure": true}},
    {"name": "sanitize", "configurePreset": "sanitize", "output": {"outputOnFailure": true}},
    {"name": "core", "configurePreset": "core", "output": {"outputOnFailure": true}}
  ]
}
